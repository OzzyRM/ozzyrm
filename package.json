{
  "name": "ozzyrm-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli",
    "core",
    "drizzle",
    "prisma",
    "react",
    "ui"
  ],
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --cwd web dev",
    "watch:schema": "bun run scripts/watch-schema.ts",
    "build": "bun run --cwd core build && bun run --cwd prisma build && bun run --cwd drizzle build && bun run --cwd ui build && bun run --cwd react build && bun run --cwd cli build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.0",
    "@ozzyrm/core": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
