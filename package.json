{
  "name": "ozzyrm",
  "version": "0.3.0",
  "description": "Schema documentation toolkit for Prisma, Drizzle, and raw SQL",
  "license": "MIT",
  "bin": {
    "ozzyrm": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/server": {
      "types": "./dist/react/server.d.ts",
      "default": "./dist/react/server.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./styles.css": "./src/ui/styles.css"
  },
  "files": [
    "dist",
    "src/ui/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/ui/styles.entry.css -o ./dist/ui/styles.bundled.css --minify && bun run scripts/inline-css.ts",
    "build": "bun run build:css && tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@boxicons/react": "^1.0.3",
    "@dagrejs/dagre": "^3.0.0",
    "@prisma/dmmf": "^7.0.0",
    "@prisma/internals": "^7.0.0",
    "@xyflow/react": "^12.11.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.26.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  }
}
